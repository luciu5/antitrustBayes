+
+  ## Fork warnings cannot reach the parent's condition handlers. Capture them
+  ## in each job, retain their model/repetition, and emit them once here for
+  ## the same caller-visible behavior in serial and fork execution.
+  warning_rows <- lapply(raw, function(value) {
+    messages <- value$warnings %||% character()
+    if (!length(messages)) return(NULL)
+    data.frame(model_index = as.integer(value$model_index), model = as.character(value$model),
+      repetition = as.integer(value$repetition), message = as.character(messages),
+      stringsAsFactors = FALSE)
+  })
+  warning_rows <- Filter(Negate(is.null), warning_rows)
+  warnings <- if (length(warning_rows)) do.call(rbind, warning_rows) else
+    data.frame(model_index = integer(), model = character(), repetition = integer(),
+      message = character(), stringsAsFactors = FALSE)
+  for (message in warnings$message) warning(message, call. = FALSE)
 
