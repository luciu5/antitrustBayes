+}
+
+.bayes_bridge_restore_rng <- function(state) {
+  if (!is.list(state) || !is.character(state$kind) ||
+      length(state$kind) != 3L || !is.logical(state$had_seed) ||
+      length(state$had_seed) != 1L) {
+    stop("Invalid saved RNG state.", call. = FALSE)
+  }
+  ## RNGkind() itself can create .Random.seed, so restore the generator first
+  ## and then restore the caller's exact seed presence/value.
+  do.call(RNGkind, as.list(state$kind))
+  if (isTRUE(state$had_seed)) {
+    assign(".Random.seed", state$seed, envir = .GlobalEnv)
+  } else if (exists(".Random.seed", envir = .GlobalEnv, inherits = FALSE)) {
+    rm(".Random.seed", envir = .GlobalEnv)
+  }
+  invisible(TRUE)
+}
+
+.bayes_bridge_preserve_rng <- function(expr) {
+  state <- .bayes_bridge_rng_state()
+  on.exit(.bayes_bridge_restore_rng(state), add = TRUE)
   force(expr)
 }
 
+.bayes_bridge_validate_cores <- function(bridge_cores) {
+  if (length(bridge_cores) != 1L || !is.numeric(bridge_cores) ||
+      !is.finite(bridge_cores) || bridge_cores < 1 ||
+      bridge_cores > .Machine$integer.max ||
+      bridge_cores != floor(bridge_cores)) {
+    stop("'bridge_cores' must be a positive integer.", call. = FALSE)
+  }
+  as.integer(bridge_cores)
+}
+
+.bayes_bridge_validate_seed <- function(bridge_seed) {
+  if (is.null(bridge_seed)) return(NULL)
+  if (length(bridge_seed) != 1L || !is.numeric(bridge_seed) ||
+      !is.finite(bridge_seed) || bridge_seed != floor(bridge_seed) ||
+      bridge_seed < -2147483647 || bridge_seed > 2147483647) {
+    stop("'bridge_seed' must be a finite integer accepted by set.seed().",
+         call. = FALSE)
+  }
+  as.integer(bridge_seed)
+}
+
+.bayes_bridge_allocate_streams <- function(n_jobs, bridge_seed = NULL,
+                                           derive = FALSE) {
+  if (length(n_jobs) != 1L || !is.numeric(n_jobs) || !is.finite(n_jobs) ||
+      n_jobs < 1 || n_jobs != as.integer(n_jobs)) {
+    stop("The number of bridge jobs must be a positive integer.",
+         call. = FALSE)
+  }
+  n_jobs <- as.integer(n_jobs)
+  explicit <- !is.null(bridge_seed)
+  if (!explicit && !isTRUE(derive)) {
+    return(list(streams = NULL, realized_seed = NULL,
+                seed_source = "none", stream_kind = NULL,
+                caller_state_after_seed = NULL))
+  }
+
+  caller_state_after_seed <- NULL
+  if (explicit) {
+    bridge_seed <- .bayes_bridge_validate_seed(bridge_seed)
+    set.seed(bridge_seed)
+  } else {
+    ## A parallel request without an explicit seed still needs independent
+    ## fork streams.  Drawing one seed is the only intentional caller-RNG
+    ## consumption in this branch; dispatch restores the resulting state.
+    realized <- sample.int(.Machine$integer.max, size = 1L)
+    bridge_seed <- as.integer(realized)
+    caller_state_after_seed <- .bayes_bridge_rng_state()
+    on.exit(.bayes_bridge_restore_rng(caller_state_after_seed), add = TRUE)
+    set.seed(bridge_seed)
+  }
+  RNGkind("L'Ecuyer-CMRG")
+  set.seed(bridge_seed)
+  streams <- vector("list", n_jobs)
+  streams[[1L]] <- get(".Random.seed", envir = .GlobalEnv)
+  if (n_jobs > 1L) {
+    for (i in 2L:n_jobs) {
+      streams[[i]] <- parallel::nextRNGStream(streams[[i - 1L]])
+    }
+  }
+  list(streams = streams, realized_seed = bridge_seed,
+       seed_source = if (explicit) "explicit" else "caller",
+       stream_kind = RNGkind(), caller_state_after_seed = caller_state_after_seed)
+}
+
+.bayes_bridge_run_job <- function(job, bridge_maxiter,
+                                   bridge_fun = bridgesampling::bridge_sampler) {
+  if (!is.null(job$stream)) {
+    assign(".Random.seed", as.integer(job$stream), envir = .GlobalEnv)
+  }
+  tryCatch({
+    value <- bridge_fun(
+      job$context$samples, stanfit_model = job$context$stanfit_model,
+      silent = TRUE, maxiter = bridge_maxiter
+    )
+    if (!is.list(value) || length(value$logml) != 1L ||
+        !is.numeric(value$logml) || !is.finite(value$logml)) {
+      stop("bridge_sampler returned no finite log marginal likelihood.",
+           call. = FALSE)
+    }
+    list(model_index = job$model_index, model = job$model,
+         repetition = job$repetition, result = value, error = NULL,
+         stage = "bridge")
+  }, error = function(e) {
+    list(model_index = job$model_index, model = job$model,
+         repetition = job$repetition, result = NULL,
+         error = conditionMessage(e), stage = "bridge")
+  })
+}
+
+.bayes_bridge_dispatch <- function(contexts, context_errors, model_names,
+                                   bridge_repetitions, bridge_maxiter,
+                                   bridge_cores = 1L, bridge_seed = NULL,
+                                   bridge_fun = bridgesampling::bridge_sampler) {
+  n_models <- length(contexts)
+  n_jobs <- n_models * bridge_repetitions
+  bridge_cores <- .bayes_bridge_validate_cores(bridge_cores)
+  bridge_seed <- .bayes_bridge_validate_seed(bridge_seed)
+  unsupported <- identical(.Platform$OS.type, "windows")
+  effective_cores <- min(bridge_cores, n_jobs)
+  fallback <- bridge_cores > 1L && unsupported
+  if (fallback) effective_cores <- 1L
+  if (fallback) {
+    warning("'bridge_cores' > 1 is unsupported on this platform; using ",
+            "serial bridge execution.", call. = FALSE)
+  }
+
+  caller_state <- if (!is.null(bridge_seed)) .bayes_bridge_rng_state() else NULL
+  if (!is.null(caller_state)) {
+    on.exit(.bayes_bridge_restore_rng(caller_state), add = TRUE)
+  }
+  stream_plan <- if (!is.null(bridge_seed) || bridge_cores > 1L) {
+    .bayes_bridge_allocate_streams(
+      n_jobs, bridge_seed = bridge_seed, derive = bridge_cores > 1L
+    )
+  } else {
+    list(streams = NULL, realized_seed = NULL, seed_source = "none",
+         stream_kind = NULL, caller_state_after_seed = NULL)
+  }
+  if (is.null(caller_state) &&
+      !is.null(stream_plan$caller_state_after_seed)) {
+    ## Stream derivation should not leak its temporary L'Ecuyer state.  An
+    ## explicit seed restores the state from before dispatch; an implicit
+    ## parallel plan restores the state immediately after seed selection.
+    on.exit(.bayes_bridge_restore_rng(stream_plan$caller_state_after_seed),
+            add = TRUE)
+  }
+
+  jobs <- vector("list", n_jobs)
+  pos <- 0L
+  for (i in seq_len(n_models)) {
+    for (rep_id in seq_len(bridge_repetitions)) {
+      pos <- pos + 1L
+      jobs[[pos]] <- list(
+        model_index = i, model = model_names[[i]], repetition = rep_id,
+        context = contexts[[i]],
+        stream = if (is.null(stream_plan$streams)) NULL else
+          stream_plan$streams[[pos]]
+      )
+    }
+  }
+
+  run_one <- function(job) {
+    context_error <- context_errors[[job$model_index]]
+    if (is.null(job$context)) {
+      if (is.na(context_error) || !nzchar(context_error)) {
+        context_error <- "bridge context unavailable"
+      }
+      return(list(model_index = job$model_index, model = job$model,
+                  repetition = job$repetition, result = NULL,
+                  error = context_error,
+                  stage = "context"))
+    }
+    .bayes_bridge_run_job(job, bridge_maxiter, bridge_fun = bridge_fun)
+  }
+
+  raw <- tryCatch({
+    if (effective_cores > 1L) {
+      parallel::mclapply(
+        jobs, run_one, mc.cores = effective_cores,
+        mc.preschedule = TRUE, mc.set.seed = FALSE
+      )
+    } else {
+      lapply(jobs, run_one)
+    }
+  }, error = function(e) {
+    lapply(jobs, function(job) list(
+      model_index = job$model_index, model = job$model,
+      repetition = job$repetition, result = NULL,
+      error = conditionMessage(e), stage = "dispatch"
+    ))
+  })
+
+  if (length(raw) != length(jobs)) {
+    raw <- vector("list", length(jobs))
+    malformed <- rep(TRUE, length(jobs))
+  } else {
+    malformed <- !vapply(raw, function(value) {
+      is.list(value) && all(c("model_index", "model", "repetition",
+                              "result", "error", "stage") %in% names(value))
+    }, logical(1))
+  }
+  raw[malformed] <- lapply(jobs[malformed], function(job) list(
+    model_index = job$model_index, model = job$model,
+    repetition = job$repetition, result = NULL,
+    error = "worker process did not return a bridge result", stage = "dispatch"
+  ))
+
+  bridge_list <- lapply(seq_len(n_models), function(i) {
+    reps <- raw[vapply(raw, function(value) value$model_index == i, logical(1))]
+    reps <- reps[order(vapply(reps, `[[`, integer(1), "repetition"))]
+    lapply(reps, `[[`, "result")
+  })
+  failure_rows <- lapply(raw[vapply(raw, function(value) {
+    is.null(value$result) || !is.null(value$error)
+  }, logical(1))], function(value) data.frame(
+    model_index = as.integer(value$model_index), model = as.character(value$model),
+    repetition = as.integer(value$repetition), stage = as.character(value$stage),
+    error = as.character(value$error %||% "bridge result unavailable"),
+    stringsAsFactors = FALSE
+  ))
+  failures <- if (length(failure_rows)) do.call(rbind, failure_rows) else
+    data.frame(model_index = integer(0), model = character(0),
+               repetition = integer(0), stage = character(0),
+               error = character(0), stringsAsFactors = FALSE)
+  if (nrow(failures)) {
+    context_rows <- which(failures$stage == "context")
+    if (length(context_rows)) {
+      first <- context_rows[!duplicated(failures$model_index[context_rows])]
+      for (i in first) {
+        warning("Bridge context restoration failed for model ",
+                failures$model[[i]], "; evidence marked incomplete: ",
+                failures$error[[i]], call. = FALSE)
+      }
+    }
+    bridge_rows <- which(failures$stage != "context")
+    for (i in bridge_rows) {
+      warning("Bridge sampling failed for model ", failures$model[[i]],
+              ", repetition ", failures$repetition[[i]], ": ",
+              failures$error[[i]], call. = FALSE)
+    }
+  }
+  execution <- list(
+    requested_cores = bridge_cores,
+    effective_cores = effective_cores,
+    dispatch = if (effective_cores > 1L) "fork" else "serial",
+    fallback = if (fallback) "unsupported_platform" else NULL,
+    seed_source = stream_plan$seed_source,
+    realized_seed = stream_plan$realized_seed,
+    stream_kind = stream_plan$stream_kind,
+    n_jobs = n_jobs
+  )
+  list(bridge_list = bridge_list, failures = failures,
+       execution = execution)
+}
+
